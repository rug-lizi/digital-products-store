[Unit]
Description=Adam Li Digital Store
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/digital-products/store
EnvironmentFile=/etc/digital-shop.env
ExecStart=/usr/bin/node /home/ubuntu/digital-products/store/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/digital-products/store/data

[Install]
WantedBy=multi-user.target
